[Unit]
Description=Polybot Telegram Bot - DEV
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/PlayBotService
ExecStart=/home/ubuntu/PlayBotService/venv/bin/python3 -m polybot.app
Restart=always
RestartSec=5
Environment=TELEGRAM_BOT_TOKEN=8114485374:AAEd8gZSRBuOQUu8w10IIZVbQQN_WNJuqmU
Environment=YOLO_URL=http://10.0.1.226:8080
Environment=AWS_S3_BUCKET=yazan-dev-images-polybot
Environment=BOT_APP_URL=https://yazanpolybot-dev.fursa.click
Environment=BOT_APP_CERT_PATH=/home/ubuntu/PlayBotService/polybot/polybot-dev.crt

[Install]
WantedBy=multi-user.target
